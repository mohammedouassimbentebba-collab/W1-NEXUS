  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uri",
        "artifact_version"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "artifact_version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "approvalRef": {
      "allOf": [
        {
          "$ref": "urn:w1-cip:schema:0.1:entity-ref"
        },
        {
          "properties": {
            "entity_type": {
              "const": "approval"
            }
          }
        }
      ]
    },
    "classificationCheckRef": {
      "allOf": [
        {
          "$ref": "urn:w1-cip:schema:0.1:entity-ref"
        },
        {
          "properties": {
            "entity_type": {
              "enum": [
                "verification",
                "review"
              ]
            }
          }
        }
      ]
    },
    "changeMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_reason",
        "substantive_effect"
      ],
      "properties": {
        "change_reason": {
          "enum": [
            "semantic",
            "editorial_correction"
          ]
        },
        "substantive_effect": {
          "enum": [
            "may_affect_dependents",
            "none"
          ]
        },
        "diff_artifact": {
          "$ref": "#/$defs/artifactRef"
        },
        "classification_approval": {
          "$ref": "#/$defs/approvalRef"
        },
        "classification_check": {
          "$ref": "#/$defs/classificationCheckRef"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "substantive_effect": {
                "const": "none"
              }
            },
            "required": [
              "substantive_effect"
            ]
          },
          "then": {
            "required": [
              "diff_artifact",
              "classification_approval",
              "classification_check"
            ],
            "properties": {
              "change_reason": {
                "const": "editorial_correction"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "change_reason": {
                "const": "semantic"
              }
            },
            "required": [
              "change_reason"
            ]
          },
          "then": {
            "properties": {
              "substantive_effect": {
                "const": "may_affect_dependents"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "classification_approval"
                  ]
                },
                {
                  "required": [
                    "classification_check"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  }
}
