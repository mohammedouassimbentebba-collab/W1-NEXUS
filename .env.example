# ==============================================================================
# W1™ NEXUS — Environment Configuration Template
# Copy this file to '.env' and populate with your API credentials.
# NEVER commit the real '.env' file to version control.
# ==============================================================================

# NVIDIA NIM API Credentials
# Required for multi-model catalog discovery and benchmark inference
NVIDIA_API_KEY=nvapi-your-primary-nvidia-nim-api-key-here

# Optional: Specific Credential Profiles (Multi-Account / Entitlement Routing)
# NVIDIA_API_KEY_KIMI=nvapi-optional-secondary-key-for-kimi
# NVIDIA_API_KEY_MUSE=nvapi-optional-secondary-key-for-muse
# NVIDIA_API_KEY_DEEPSEEK=nvapi-optional-secondary-key-for-deepseek

# AgentRouter / Multi-Model Gateway Credentials
# AGENTROUTER_API_KEY=sk-your-agentrouter-primary-key-here
# AGENTROUTER_KEY_DEEPSEEK=sk-your-dedicated-deepseek-key-here
# AGENTROUTER_KEY_OPUS5=sk-your-dedicated-opus5-key-here
# AGENTROUTER_KEY_ASTRA=sk-your-dedicated-astra-key-here
# AGENTROUTER_KEY_OPUS48=sk-your-dedicated-opus48-key-here

# OpenRouter Unified Gateway
# OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

