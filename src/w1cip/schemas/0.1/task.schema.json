{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:w1-cip:entity-payload:0.1:task",
  "title": "W1-CIP Task legal payload v0.1",
  "description": "One phase-bounded unit of work linked to a pinned goal and team plan, with dependencies, assignment, required outputs, budget allocation, and operational status.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "goal",
    "team_plan",
    "title",
    "description",
    "phase",
    "status",
    "dependencies",
    "required_outputs",
    "budget_allocation"
  ],
  "properties": {
    "goal": {
      "$ref": "#/$defs/goalRef"
    },
    "team_plan": {
      "$ref": "#/$defs/teamPlanRef"
    },
    "title": {
      "$ref": "#/$defs/nonEmptyText"
    },
    "description": {
      "$ref": "#/$defs/nonEmptyText"
    },
    "phase": {
      "enum": [
        "planning",
        "execution",
        "review",
        "verification",
        "revision",
        "approval",
        "synthesis"
      ]
    },
    "status": {
      "enum": [
        "created",
        "ready",
        "assigned",
        "in_progress",
        "blocked",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "assigned_role_assignment": {
      "$ref": "#/$defs/roleAssignmentRef"
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/taskDependency"
      }
    },
    "required_outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/outputRequirement"
      }
    },
    "produced_outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/producedOutput"
      }
    },
    "budget_allocation": {
      "$ref": "#/$defs/budgetAllocation"
    },
    "required_context_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "block_reason": {
      "enum": [
        "dependency",
        "evidence_required",
        "revision_required",
        "awaiting_approval",
        "awaiting_user",
        "resource_unavailable"
      ]
    },
    "status_reason": {
      "$ref": "#/$defs/nonEmptyText"
    },
    "completion_summary": {
      "$ref": "#/$defs/nonEmptyText"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "assigned",
              "in_progress",
              "completed",
              "failed"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "assigned_role_assignment"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "block_reason",
          "status_reason"
        ],
        "not": {
          "required": [
            "completion_summary"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "failed",
              "cancelled"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "status_reason"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "block_reason"
              ]
            },
            {
              "required": [
                "completion_summary"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "produced_outputs",
          "completion_summary"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "block_reason"
              ]
            },
            {
              "required": [
                "status_reason"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "created",
              "ready",
              "assigned",
              "in_progress"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "block_reason"
              ]
            },
            {
              "required": [
                "status_reason"
              ]
            },
            {
              "required": [
                "completion_summary"
              ]
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "entityType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "nonEmptyText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "goalRef": {
      "allOf": [
        {
          "$ref": "urn:w1-cip:schema:0.1:entity-ref"
        },
        {
          "properties": {
            "entity_type": {
              "const": "goal_contract"
            }
          }
        }
      ]
    },
    "teamPlanRef": {
      "allOf": [
        {
          "$ref": "urn:w1-cip:schema:0.1:entity-ref"
        },
        {
          "properties": {
            "entity_type": {
              "const": "team_plan"
            }
          }
        }
      ]
    },
    "roleAssignmentRef": {
      "allOf": [
        {
          "$ref": "urn:w1-cip:schema:0.1:entity-ref"
        },
        {
          "properties": {
            "entity_type": {
              "const": "role_assignment"
            }
          }
        }
      ]
    },
    "taskRef": {
      "allOf": [
        {
          "$ref": "urn:w1-cip:schema:0.1:entity-ref"
        },
        {
          "properties": {
            "entity_type": {
              "const": "task"
            }
          }
        }
      ]
    },
    "taskDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task",
        "required_status"
      ],
      "properties": {
        "task": {
          "$ref": "#/$defs/taskRef"
        },
        "required_status": {
          "const": "completed"
        }
      }
    },
    "outputRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_id",
        "entity_type",
        "description",
        "required"
      ],
      "properties": {
        "output_id": {
          "$ref": "#/$defs/identifier"
        },
        "entity_type": {
          "$ref": "#/$defs/entityType"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyText"
        },
        "required": {
          "type": "boolean"
        },
        "goal_deliverable_id": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "producedOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_id",
        "entity"
      ],
      "properties": {
        "output_id": {
          "$ref": "#/$defs/identifier"
        },
        "entity": {
          "$ref": "urn:w1-cip:schema:0.1:entity-ref"
        }
      }
    },
    "budgetAllocation": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "max_model_calls": {
          "type": "integer",
          "minimum": 0
        },
        "max_review_cycles": {
          "type": "integer",
          "minimum": 0
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "max_elapsed_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
